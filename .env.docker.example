POSTGRES_PASSWORD=change-this-password
FRONTEND_PORT=8080

# Public HTTPS origin used for OAuth callbacks and provider webhooks.
WEBHOOK_BASE_URL=https://mail.example.com
BACKEND_PUBLIC_URL=https://mail.example.com
FRONTEND_ORIGIN=https://mail.example.com

# Provider OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mail.example.com/api/auth/google/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://mail.example.com/api/auth/microsoft/callback
MICROSOFT_WEBHOOK_CLIENT_STATE=

# Application secrets
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMAIL_CLASSIFICATION_MODE=ai_only

# Sync policy
AUTO_SYNC_INTERVAL_SECONDS=120
AUTO_SYNC_WEBHOOK_SAFETY_NET_SECONDS=900
AUTO_SYNC_MAX_MESSAGES=200

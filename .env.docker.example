# Docker Compose overrides for Auto AI Email Checker.
# Copy values you need into `.env`, or pass them when running compose.
# OAuth / AI keys still come from your normal `.env`.

POSTGRES_USER=email_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=email_platform
POSTGRES_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

API_PORT=8000
FRONTEND_PORT=5173

# Browser-facing URLs (host machine).
FRONTEND_ORIGIN=http://localhost:5173
# Reserved ngrok HTTPS URL used by the Compose ngrok service (--url).
WEBHOOK_BASE_URL=https://your-subdomain.ngrok-free.dev
BACKEND_PUBLIC_URL=https://your-subdomain.ngrok-free.dev
GOOGLE_REDIRECT_URI=https://your-subdomain.ngrok-free.dev/api/auth/google/callback
MICROSOFT_REDIRECT_URI=https://your-subdomain.ngrok-free.dev/api/auth/microsoft/callback

# Required for the default Compose ngrok tunnel. docker-up.ps1 can also load
# this from %LOCALAPPDATA%\ngrok\ngrok.yml when unset.
NGROK_AUTHTOKEN=
NGROK_INSPECT_PORT=4040
NGROK_AGENT_URL=http://ngrok:4040/api/tunnels

# Compose always rewrites DATABASE_URL / RABBITMQ_URL to the docker network hosts.
DISTRIBUTED_RUNTIME=true
RUN_DB_INIT=true

# Docker Compose overrides for Auto AI Email Checker.
# Copy values you need into `.env`, or pass them when running compose.
# OAuth / AI keys still come from your normal `.env`.

POSTGRES_USER=email_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=email_platform
POSTGRES_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

API_PORT=8000
FRONTEND_PORT=5173

# Browser-facing URLs (host machine).
FRONTEND_ORIGIN=http://localhost:5173
WEBHOOK_BASE_URL=http://127.0.0.1:8000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/auth/microsoft/callback

# Compose always rewrites DATABASE_URL / RABBITMQ_URL to the docker network hosts.
DISTRIBUTED_RUNTIME=true
RUN_DB_INIT=true

# Native Windows development configuration.
# Point this at the local PostgreSQL instance initialized for the project.
DATABASE_URL=postgresql+psycopg://email_app:change-me@127.0.0.1:5432/email_platform

# Native startup requires RabbitMQ on the local AMQP port.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=aec.events
RABBITMQ_ROUTING_PREFIX=aec
RABBITMQ_PREFETCH_COUNT=8
RABBITMQ_OUTBOX_BATCH_SIZE=100
RABBITMQ_OUTBOX_POLL_SECONDS=0.25

WEBHOOK_BASE_URL=http://127.0.0.1:8000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/api/auth/microsoft/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_WEBHOOK_CLIENT_STATE=change-me-to-a-long-random-string

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=change-me-session-secret
EMAIL_CLASSIFICATION_MODE=ai_only
